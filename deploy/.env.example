# BSKG settings. Copy to deploy/.env on the AWS host and fill in the secrets.
# .env is excluded from version control. Never commit a real secret.

# --- Neo4j (required) ---
# Password for the neo4j user. Required by the neo4j, worker, and api services.
NEO4J_PASSWORD=
# Bolt address and user used by bskg (defaults suit the Compose network).
BSKG_NEO4J_URI=bolt://neo4j:7687
BSKG_NEO4J_USER=neo4j
# Neo4j memory for the 8 GB host (defaults). For 16 GB see .env.16gb.
NEO4J_HEAP=2g
NEO4J_PAGECACHE=2500m
NEO4J_MEM_LIMIT=5632m

# --- Logging ---
# debug, info, warn, or error.
BSKG_LOG_LEVEL=info

# --- API ---
BSKG_API_ADDR=:8080
# Both or neither: enable TLS 1.2+ in the API.
BSKG_API_TLS_CERT_FILE=
BSKG_API_TLS_KEY_FILE=
# Requests per API key per 60 seconds.
BSKG_API_RATE_LIMIT=120
# Timeout per Graph_Store query (Go duration).
BSKG_QUERY_TIMEOUT=10s
# HMAC key for paging cursors. Required for the API. Use a long random value.
BSKG_CURSOR_SECRET=
# How long GET /v1/stats results are cached (Go duration, 1m to 60m).
BSKG_STATS_TTL=5m
# Time limit for one statistics computation (Go duration, 1s to 120s).
BSKG_STATS_TIMEOUT=30s
# Enable the co-exploitation queries.
BSKG_ENABLE_COEXPLOITATION=false

# --- Build and sync ---
# Sample build: ingest at most N CVEs, check the result, then unset it to continue
# to the full build. Recommended first value: 1000. Empty means a full build.
BSKG_SAMPLE_LIMIT=
# Which CVEs a sample build takes: first (the oldest N, default) or latest (the most
# recent N by NVD index order). Changing it re-runs the NVD and Exploit-DB jobs.
# Only used when BSKG_SAMPLE_LIMIT is set.
BSKG_SAMPLE_ORDER=first
# Records per Graph_Store transaction (1 to 10000).
BSKG_BATCH_SIZE=500
# Optional NVD API key (raises the NVD rate limit).
NVD_API_KEY=
# Enabled sources. Each needs a complete entry in docs/sources.md.
BSKG_ENABLED_SOURCES=cwe,nvd,exploitdb
# Daily schedule time in UTC (HH:MM).
BSKG_NVD_SYNC_TIME=03:00
# Hours after which the graph reports stale data (1 to 720).
BSKG_STALE_AFTER_HOURS=48
# Days to keep Change records (1 to 3650).
BSKG_CHANGE_RETENTION_DAYS=365

# --- Phase 2 (not used in phase 1) ---
GITHUB_TOKEN=
BSKG_EPSS_CHANGE_THRESHOLD=0.01
